# ─────────────────────────────────────────────
#  Quantum-Secure Federated Firewall
#  .env.example — copy to .env and fill values
# ─────────────────────────────────────────────

# ── General ───────────────────────────────────
PROJECT_NAME=quantum_secure_federated_firewall
ENV=development          # development | staging | production
LOG_LEVEL=INFO

# ── Node Identity ─────────────────────────────
NODE_ID=node_01
NODE_ROLE=edge           # edge | aggregator

# ── Networking ────────────────────────────────
AGGREGATOR_HOST=localhost
AGGREGATOR_PORT=8443
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DASHBOARD_PORT=5173

# ── Database ──────────────────────────────────
DATABASE_URL=sqlite:///./data/firewall.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Vector Database ───────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
VECTOR_DB_PATH=./data/vector_db

# ── RL Agent ──────────────────────────────────
RL_MODEL_PATH=./rl_agent/models/checkpoints/
RL_CHECKPOINT_INTERVAL=100   # episodes

# ── PQC Security ─────────────────────────────
PQC_KEY_DIR=./pqc_security/keys/
PQC_KEM_ALGORITHM=Kyber768
PQC_SIG_ALGORITHM=Dilithium3
KEY_ROTATION_INTERVAL=3600   # seconds

# ── Federated Learning ────────────────────────
FL_ROUNDS=10
FL_MIN_CLIENTS=2
FL_FRACTION_FIT=1.0

# ── RAG / LLM ─────────────────────────────────
# Uncomment and fill for cloud LLM:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# Local Ollama endpoint (default):
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3

# ── NVD CVE Feed ─────────────────────────────
NVD_API_KEY=your_nvd_api_key_here

# ── Packet Capture ────────────────────────────
CAPTURE_INTERFACE=eth0
CAPTURE_FILTER=ip
PCAP_REPLAY_PATH=./data/raw/network_traffic/
